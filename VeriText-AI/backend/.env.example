# VeriText AI — environment configuration example
#
# Windows PowerShell:
#   Copy-Item backend\.env.example backend\.env    # values are read from the process env
#   $env:VERITEXT_DEVICE = "auto"
#
# Every value has a safe default in backend/config.py; nothing here is required
# for a local run. Prefer setting only what you need to override.

# ------------------------------------------------------------------- server
VERITEXT_HOST=0.0.0.0
VERITEXT_PORT=5000
VERITEXT_DEBUG=false
VERITEXT_LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (the Vite dev server by default).
VERITEXT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------- hardware / device
# auto  = CUDA when a CUDA-enabled PyTorch build can see a GPU, CPU otherwise
# cuda  = prefer the GPU (falls back to CPU with a note if unavailable)
# cpu   = never touch the GPU
VERITEXT_DEVICE=auto
# Embedding batch size. 0 = per-device default (16 on GPU, 32 on CPU).
# Set an explicit value to override both, e.g. 8 on a 4 GB GPU under memory pressure.
VERITEXT_EMBED_BATCH=0
VERITEXT_EMBED_BATCH_GPU=16
VERITEXT_EMBED_BATCH_CPU=32
VERITEXT_EMBED_CACHE=20000
VERITEXT_EMBED_WARMUP=true
# CPU threads used when inference runs on the CPU.
VERITEXT_TORCH_THREADS=4
# If CUDA runs out of memory, retry with a smaller batch and finally move to CPU.
VERITEXT_CUDA_FALLBACK_TO_CPU=true
# Cosine search memory: peak is O(BLOCK_ROWS x sentences_in_other_document).
VERITEXT_SIMILARITY_BLOCK_ROWS=256

# ---------------------------------------------------------------- NLP model
VERITEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# true = never contact Hugging Face; require the model to be in the local cache.
VERITEXT_MODEL_LOCAL_ONLY=false

# ------------------------------------------------------------------ uploads
VERITEXT_MAX_UPLOAD_MB=25
VERITEXT_MAX_DOCUMENT_CHARS=400000
VERITEXT_MAX_SENTENCES=4000

# --------------------------------------------------------- match thresholds
# Calibrated on the labelled evaluation set; see docs/evaluation_results.md.
VERITEXT_SEMANTIC_THRESHOLD=0.62
VERITEXT_HIGH_SIMILARITY=0.80
VERITEXT_MODERATE_SIMILARITY=0.65
VERITEXT_NEAR_EXACT_LEXICAL=0.85
VERITEXT_TOP_K=3
VERITEXT_MIN_SENTENCE_WORDS=5
VERITEXT_PARAGRAPH_THRESHOLD=0.60
VERITEXT_SUPPRESS_COMMON=true

# ------------------------------------------------------------------ privacy
# Extracted text is retained only this long for the comparison viewer.
# Set to 0 to keep no extracted text at all (the viewer will be unavailable).
VERITEXT_TEXT_TTL_MINUTES=120
VERITEXT_TEXT_TO_DISK=true
VERITEXT_RETAIN_SNIPPETS=true
VERITEXT_SNIPPET_CHARS=600

# ------------------------------------------------------------------ storage
# Relative paths are resolved from the backend directory; on Windows an absolute
# path such as D:\VeriText\storage is fine too (use forward slashes or double quotes).
VERITEXT_STORAGE_DIR=../storage
VERITEXT_DB_PATH=../storage/veritext.sqlite3
VERITEXT_TEMP_DIR=../storage/tmp
